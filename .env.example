# ============================================================================
# Copy file này thành .env.local rồi điền giá trị thật.
# File .env.local KHÔNG được đẩy lên GitHub (đã nằm trong .gitignore).
# Trên Vercel thì không dùng file, mà vào Settings > Environment Variables để dán.
# ============================================================================

# --- Địa chỉ website sau khi deploy (dùng cho SEO, RSS, link chia sẻ) ---
NEXT_PUBLIC_SITE_URL=https://my-portfolio-kamon.vercel.app

# --- Bình luận: lấy ở https://giscus.app (xem SETUP.md phần 4) ---
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# --- Đếm lượt xem: lấy ở https://console.upstash.com (xem SETUP.md phần 5) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Số lượt bình luận hiện ở danh sách blog ---
# Token GitHub chỉ cần quyền đọc public repo. Tạo tại:
# https://github.com/settings/tokens?type=beta  (Fine-grained > Public Repositories read-only)
# Không có token thì site vẫn chạy, chỉ là không hiện số bình luận.
GITHUB_TOKEN=
